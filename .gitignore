# ---- Unity (the Unity project lives in game/) ----
# Folders Unity regenerates; never commit them.
/game/[Ll]ibrary/
/game/[Tt]emp/
/game/[Oo]bj/
/game/[Bb]uild/
/game/[Bb]uilds/
/game/[Ll]ogs/
/game/[Uu]ser[Ss]ettings/
/game/[Mm]emory[Cc]aptures/
/game/[Rr]ecordings/

# Asset meta data should only be ignored when the corresponding asset is also ignored
!/game/[Aa]ssets/**/*.meta

# Autogenerated by Rider's Unity plugin
/game/[Aa]ssets/Plugins/Editor/JetBrains*

# Addressables build output
/game/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bin*
/game/[Aa]ssets/[Ss]treamingAssets/aa.meta
/game/[Aa]ssets/[Ss]treamingAssets/aa/*

# Solution and project files Unity generates for the code editor
/game/*.csproj
/game/*.sln
/game/*.slnx
/game/*.unityproj

# IDE state
/game/.vs/
/game/.idea/
.consulo/
*.suo
*.user
*.userprefs

# Build and debug by-products
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db
*.pidb.meta
*.pdb.meta
*.mdb.meta
*.tmp
sysinfo.txt
mono_crash.*
crashlytics-build.properties

# Packaged builds and exports
*.apk
*.aab
*.app
*.unitypackage
*.unitypackage.meta

# ---- Operating systems ----
.DS_Store
Thumbs.db
Desktop.ini

# Standalone local gameplay checks
/tools/LocalGameplay.Tests/bin/
/tools/LocalGameplay.Tests/obj/
